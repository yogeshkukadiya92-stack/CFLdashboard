DATABASE_URL=postgres://user:password@host:5432/dbname
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_RESET_DEMO_DATA=false
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin User
ADMIN_MOBILE=
ADMIN_PASSWORD=replace_with_strong_password
AUTH_SECRET=replace_with_long_random_secret
ADMIN_MANUAL_OTP_CODE=
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=replace_with_server_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret
RESEND_API_KEY=re_xxxxx
WHATSAPP_API_TOKEN=replace_with_provider_token
MFW_API_BASE_URL=https://your-mfw-api.example.com
MFW_INTEGRATION_API_KEY=replace_with_mfw_server_key
# Optional legacy fallback. New mappings are selected per workshop in Workshop Master.
MFW_WORKSHOP_MAP={}
CALLFLOW_AUTH_SECRET=replace_with_long_random_callflow_secret
CRON_SECRET=replace_with_long_random_cron_secret
CALLFLOW_DAILY_REPORT_WEBHOOK_URL=https://your-whatsapp-or-email-automation.example.com/callflow-report

# Supervised web processes per container; each owns its own database pools.
# Default 4 uses up to 40 DB connections (80 during a rolling deployment).
WEB_CONCURRENCY=4
# Separate admin and submission pools per process.
# Budget WEB_CONCURRENCY * (DB_POOL_MAX + REGISTRATION_DB_POOL_MAX) per container.
DB_POOL_MAX=5
REGISTRATION_DB_POOL_MAX=5
# Coolify's long-running Next server starts a durable follow-up worker by default.
# Leave enabled on at least one replica; disabled replicas still enqueue jobs.
REGISTRATION_WORKER_ENABLED=true
# Bounded external follow-ups across all processes/replicas, not per replica.
REGISTRATION_JOB_CONCURRENCY=2

# Read-only remote MCP, disabled until explicitly configured and approved.
MCP_ENABLED=false
MCP_RESOURCE_URL=https://dashboard.coachforlife.in/api/mcp
# Use local for built-in master-admin consent; external remains available.
MCP_OAUTH_MODE=local
# Approved clients only. Configure exact callbacks from each app's MCP UI.
# Public-client example: [{"id":"cfl_chatgpt","name":"ChatGPT","redirectUris":["https://exact-callback-from-chatgpt"]}]
# Confidential clients add a random secret of at least 32 characters.
MCP_OAUTH_CLIENTS=[]
# A dedicated PostgreSQL role granted SELECT on the approved cfl_mcp views only.
MCP_DATABASE_URL=
# External mode only: exact OAuth issuer and pinned HTTPS JWKS URL.
MCP_OAUTH_ISSUER=
MCP_OAUTH_JWKS_URL=
# External mode only: explicit provider user IDs (sub claims), comma-separated.
MCP_ALLOWED_SUBJECTS=
# Optional additional HTTPS browser origins; no wildcard permitted.
MCP_ALLOWED_ORIGINS=
