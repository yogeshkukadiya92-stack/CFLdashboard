DATABASE_URL=postgres://user:password@host:5432/dbname
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_RESET_DEMO_DATA=false
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin User
ADMIN_MOBILE=
ADMIN_PASSWORD=replace_with_strong_password
AUTH_SECRET=replace_with_long_random_secret
ADMIN_MANUAL_OTP_CODE=
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=replace_with_server_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret
RESEND_API_KEY=re_xxxxx
WHATSAPP_API_TOKEN=replace_with_provider_token
MFW_API_BASE_URL=https://your-mfw-api.example.com
MFW_INTEGRATION_API_KEY=replace_with_mfw_server_key
# Optional legacy fallback. New mappings are selected per workshop in Workshop Master.
MFW_WORKSHOP_MAP={}
CALLFLOW_AUTH_SECRET=replace_with_long_random_callflow_secret
CRON_SECRET=replace_with_long_random_cron_secret
CALLFLOW_DAILY_REPORT_WEBHOOK_URL=https://your-whatsapp-or-email-automation.example.com/callflow-report

# Supervised web processes per container; each owns its own database pools.
# Default 2 uses up to 40 DB connections (80 during a rolling deployment).
WEB_CONCURRENCY=2
# Dedicated primary-DB submission pool per process, plus shared admin pool (10).
# Budget WEB_CONCURRENCY * (10 + REGISTRATION_DB_POOL_MAX) per container.
REGISTRATION_DB_POOL_MAX=10
# Coolify's long-running Next server starts a durable follow-up worker by default.
# Leave enabled on at least one replica; disabled replicas still enqueue jobs.
REGISTRATION_WORKER_ENABLED=true
# Bounded external follow-ups across all processes/replicas, not per replica.
REGISTRATION_JOB_CONCURRENCY=2
