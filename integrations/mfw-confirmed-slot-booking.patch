+export async function bookWorkshopAppointment({token, slotId, note, responseId}, {models, me, enrolledParticipant}) {
+      const form = await models.HealthyForeverWorkshopForm.findOne({ shareToken: token, status: "PUBLISHED", isDeleted: false });
+      if (!form?.appointments?.enabled) throw new GraphQLError("Appointments are not enabled for this form.");
+      const slot = (Array.isArray(form.appointments.slots) ? form.appointments.slots : []).find((item) => item.id === String(slotId));
+      if (!slot || slot.active === false) throw new GraphQLError("This appointment slot is unavailable.");
+      if (slot.manuallyFull === true) throw new GraphQLError("This appointment slot is full. Please choose another slot.");
+      const start = new Date(slot.startsAt);
+      const endsAt = new Date(slot.endsAt);
+      const now = new Date();
+      const registeredMobileOnly = registeredMobileAccessFor(form);
+      if (registeredMobileOnly && ((form.openAt && now < form.openAt) || (form.closeAt && now > form.closeAt))) {
+        throw new GraphQLError("This workshop form is unavailable.");
+      }
+      if (registeredMobileOnly && !responseId && !enrolledParticipant) throw new GraphQLError("Submit this form before booking an appointment.");
+      if (start <= now) throw new GraphQLError("This appointment slot has already started.");
+      if (slot.bookingCloseAt && new Date(slot.bookingCloseAt) <= now) throw new GraphQLError("Booking for this slot is closed.");
+      let response = null;
+      let participant = null;
+      let userId = me?.id || null;
+      if (enrolledParticipant) {
+        if (String(form.eventId) !== String(enrolledParticipant.eventId) || enrolledParticipant.status !== "ACTIVE") throw new GraphQLError("Workshop enrollment does not match.");
+        participant = enrolledParticipant;
+        userId = participant.userId;
+      } else if (responseId) {
+        response = await models.HealthyForeverWorkshopFormResponse.findOne({ _id: responseId, formId: form.id, isDeleted: false });
+        if (!response) throw new GraphQLError("Submit this form before booking an appointment.");
+        if (registeredMobileOnly) {
+          const match = await requireRegisteredMobileParticipant(models, form, response.answers?.[form.publicAccess.mobileFieldKey]);
+          if (String(response.participantId) !== String(match.participant.id) || String(response.userId) !== String(match.user.id)) {
+            throw new GraphQLError("This form response belongs to another participant.");
+          }
+          assertWorkshopFormGender(form, match.user, {});
+        }
+        if (!registeredMobileOnly && me?.id && String(response.userId) !== String(me.id)) throw new GraphQLError("This form response belongs to another participant.");
+        participant = await models.HealthyForeverParticipant.findOne({ _id: response.participantId, eventId: form.eventId, status: "ACTIVE", isDeleted: false });
+        userId = response.userId;
+      } else if (me?.id) {
+        participant = await models.HealthyForeverParticipant.findOne({ eventId: form.eventId, userId: me.id, status: "ACTIVE", isDeleted: false });
+      }
+      if (!participant) throw new GraphQLError("Appointment booking is only available to assigned participants.");
+      const bookingKey = `${form.id}:${slot.id}:${participant.id}`;
+      const duplicate = await models.HealthyForeverWorkshopAppointment.findOne({ bookingKey, status: "BOOKED" });
+      if (duplicate) throw new GraphQLError("You have already booked this appointment slot.");
+      const capacity = Math.max(1, Math.min(10000, Number(slot.capacity) || 1));
+      const counterId = `${form.id}:${slot.id}`;
+      let allocated = null;
+      try {
+        allocated = await models.HealthyForeverWorkshopAppointmentSlotCounter.findOneAndUpdate(
+          { _id: counterId, bookedCount: { $lt: capacity } },
+          { $inc: { bookedCount: 1 }, $set: { formId: form.id, slotId: slot.id, capacity } },
+          { upsert: true, new: true, setDefaultsOnInsert: true }
+        );
+      } catch (error) {
+        if (error?.code === 11000) {
+          allocated = await models.HealthyForeverWorkshopAppointmentSlotCounter.findOneAndUpdate(
+            { _id: counterId, bookedCount: { $lt: capacity } },
+            { $inc: { bookedCount: 1 }, $set: { capacity } },
+            { new: true }
+          );
+        } else throw error;
+      }
+      if (!allocated) throw new GraphQLError("This appointment slot is full.");
+      try {
+        const item = await models.HealthyForeverWorkshopAppointment.create({
+          formId: form.id, eventId: form.eventId, participantId: participant.id, userId,
+          responseId: response?.id || undefined, slotId: slot.id, bookingKey,
+          appointmentType: slot.appointmentType || "BOTH", location: slot.location || "",
+          staffName: slot.staffName || "", startsAt: start, endsAt,
+          note: String(note || "").trim().slice(0, 500), createdBy: me?.id || userId,
+        });
+        return { ...item.toObject(), id: item.id, participantId: participant.id };
+      } catch (error) {
+        await models.HealthyForeverWorkshopAppointmentSlotCounter.updateOne({ _id: counterId, bookedCount: { $gt: 0 } }, { $inc: { bookedCount: -1 } });
+        if (error?.code === 11000) throw new GraphQLError("You have already booked this appointment slot.");
+        throw error;
+      }
+}
