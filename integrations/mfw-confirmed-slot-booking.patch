+// CFL books for an already enrolled participant using the same slot counter as the MFW app.
+router.post("/v1/workshops/:eventId/appointments", requirePermission("customers:write"), async (req, res) => {
+  try {
+    const { formToken, participantId, slotId } = req.body || {};
+    if (typeof formToken !== "string" || typeof slotId !== "string" || !ObjectId.isValid(participantId) || !ObjectId.isValid(req.params.eventId))
+      return res.status(400).json({ message: "Invalid appointment request." });
+    const eventId = req.params.eventId;
+    const [form, participant] = await Promise.all([
+      models.HealthyForeverWorkshopForm.findOne({shareToken:formToken,eventId,status:"PUBLISHED",isDeleted:false}),
+      models.HealthyForeverParticipant.findOne({_id:participantId,eventId,status:"ACTIVE",isDeleted:false})
+    ]);
+    if (!form?.appointments?.enabled || !participant) return res.status(404).json({message:"Appointment form or enrollment unavailable."});
+    const findBooking = () => models.HealthyForeverWorkshopAppointment.findOne({formId:form.id,participantId,status:"BOOKED"});
+    let booking = await findBooking();
+    if (!booking) {
+      try {
+        booking = await bookWorkshopAppointment({token:formToken,slotId}, {models,enrolledParticipant:participant});
+      } catch (error) {
+        booking = await findBooking();
+        if (!booking) throw error;
+      }
+    }
+    return res.json({receipt:{id:booking.id,startsAt:booking.startsAt,endsAt:booking.endsAt}});
+  } catch (error) {
+    if (/slot|closed|unavailable/i.test(error.message)) return res.status(409).json({message:"Appointment unavailable."});
+    return res.status(503).json({message:"Could not complete booking."});
+  }
+});
